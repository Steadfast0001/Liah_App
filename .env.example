# =============================================================================
# Liah Academy SMS — Environment Variables Template
# =============================================================================
# Copy this file to `.env` for local Flutter development.
# IMPORTANT: Only SUPABASE_URL, SUPABASE_ANON_KEY, and APP_ENV are read by the
# Flutter client. Never put service_role or payment gateway secrets in a mobile
# client build — configure secrets via `supabase secrets set` for Edge Functions.

# -----------------------------------------------------------------------------
# 1. Public Client Variables (Flutter `.env`)
# -----------------------------------------------------------------------------
APP_ENV=development
# Environments: la-sms-dev | la-sms-staging | la-sms-prod
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------------------------------------------
# 2. Edge Function / Backend Secrets (Set via `supabase secrets set`, NOT client)
# -----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# # MTN Mobile Money (Cameroon)
# MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
# MTN_MOMO_SUBSCRIPTION_KEY=your-mtn-subscription-key
# MTN_MOMO_API_USER=your-mtn-api-user
# MTN_MOMO_API_KEY=your-mtn-api-key
# MTN_MOMO_WEBHOOK_SECRET=your-mtn-webhook-secret
#
# # Orange Money (Cameroon)
# ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/cm/v1
# ORANGE_MONEY_MERCHANT_KEY=your-orange-merchant-key
# ORANGE_MONEY_CLIENT_ID=your-orange-client-id
# ORANGE_MONEY_CLIENT_SECRET=your-orange-client-secret
# ORANGE_MONEY_WEBHOOK_SECRET=your-orange-webhook-secret
